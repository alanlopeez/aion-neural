# Base de datos PostgreSQL (Supabase, Neon, Railway o Vercel Postgres)
# Ejemplo Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Ejemplo Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/tecd_db?schema=public"

# Secreto de sesión NextAuth (genera uno con: openssl rand -base64 32)
NEXTAUTH_SECRET="tecd-super-secret-quantum-entropy-key-2026"
NEXTAUTH_URL="http://localhost:3000"
